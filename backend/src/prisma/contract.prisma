// use prisma-next

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RegistrationType {
  SELF
  COLLECTIVE
  FUTSAL
}

enum ScienceField {
  MATEMATIKA
  IPA
  IPS
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  payments      Payment[]
  registrations Registration[]
}

model Payment {
  id Int @id @default(autoincrement())

  amount   Int
  proofUrl String

  status PaymentStatus @default(PENDING)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  registrationId Int          @unique
  registration   Registration @relation(fields: [registrationId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Registration {
  id Int @id @default(autoincrement())

  type RegistrationType

  userId Int
  user   User @relation(fields: [userId], references: [id])

  participants Participant[]
  team         Team?
  payment      Payment?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Participant {
  id Int @id @default(autoincrement())

  fullName String
  school   String
  field    ScienceField

  registrationId Int
  registration   Registration @relation(
    fields: [registrationId],
    references: [id],
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Team {
  id Int @id @default(autoincrement())

  name   String
  school String

  registrationId Int          @unique
  registration   Registration @relation(
    fields: [registrationId],
    references: [id],
  )

  members TeamMember[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model TeamMember {
  id Int @id @default(autoincrement())

  fullName String

  teamId Int
  team   Team @relation(
    fields: [teamId],
    references: [id],
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}